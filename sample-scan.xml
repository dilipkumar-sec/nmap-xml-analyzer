<?xml version="1.0"?>
<nmaprun>
    <host>
        <status state="up"/>
        <address addr="192.168.1.10" addrtype="ipv4"/>

        <ports>
            <port protocol="tcp" portid="22">
                <state state="open"/>
                <service name="ssh" version="OpenSSH 9.6"/>
            </port>

            <port protocol="tcp" portid="80">
                <state state="open"/>
                <service name="http" version="Apache 2.4"/>
            </port>

            <port protocol="tcp" portid="443">
                <state state="closed"/>
                <service name="https"/>
            </port>
        </ports>
    </host>
</nmaprun>
